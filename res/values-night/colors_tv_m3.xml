    <color name="tv_surface_container_highest">@android:color/system_surface_container_highest_dark</color>
    <color name="tv_on_surface">@android:color/system_on_surface_dark</color>
    <color name="tv_on_surface_variant">@android:color/system_on_surface_variant_dark</color>
    <color name="tv_outline">@android:color/system_outline_dark</color>
    <color name="tv_outline_variant">@android:color/system_outline_variant_dark</color>
