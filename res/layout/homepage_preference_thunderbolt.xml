<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_thunderbolt_row"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="7dp"
        android:paddingEnd="10dp">

        <!-- Icon badge -->
        <FrameLayout
            android:id="@+id/icon_frame"
            android:layout_width="@dimen/tb_home_badge_size"
            android:layout_height="@dimen/tb_home_badge_size"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_thunderbolt_badge">

            <ImageView
                android:id="@android:id/icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/thunderbolt_icon_navy" />
        </FrameLayout>

        <!-- Title + subtitle -->
        <LinearLayout
            android:id="@+id/text_frame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@android:id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:textColor="@color/thunderbolt_text"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView android:id="@android:id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/thunderbolt_text_mute"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:id="@+id/tb_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_row_chevron"
            android:contentDescription="@null"
            android:tint="@color/thunderbolt_text_dim" />
    </LinearLayout>
</FrameLayout>