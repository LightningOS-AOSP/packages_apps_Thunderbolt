<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_hub_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/tv_hub_subtitle"
        android:textAppearance="@style/TextAppearance.Thunderbolt.Body" />

    <LinearLayout
        android:id="@+id/tv_active_look"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/tv_active_look_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_active_look"
                android:textAppearance="@style/TextAppearance.Thunderbolt.LabelMedium"
                android:textColor="@color/tv_on_secondary_container" />

            <TextView
                android:id="@+id/tv_active_look_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Thunderbolt.TitleLarge"
                android:textColor="@color/tv_on_secondary_container" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tv_dot_1"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <View
                    android:id="@+id/tv_dot_2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-6dp" />

                <View
                    android:id="@+id/tv_dot_3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-6dp" />

                <View
                    android:id="@+id/tv_dot_4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-6dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_active_look_edit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/tv_edit_button"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/tv_edit"
            android:textColor="@color/tv_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
