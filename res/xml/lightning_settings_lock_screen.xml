<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lock_screen_title">


    <PreferenceCategory
        android:key="lock_screen_interface_category"
        android:title="@string/lock_screen_interface_category">

        <Preference
            android:key="nowplaying_settings"
            android:title="@string/nowplaying_title"
            android:summary="@string/nowplaying_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.NowplayingSettings" />

        <Preference
            android:key="lock_glymps_settings"
            android:title="@string/lock_glymps_title"
            android:summary="@string/lock_glymps_enable_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.LockGlympsSettings" />


        <Preference
            android:key="edge_light_settings"
            android:title="@string/edge_light_title"
            android:summary="@string/edge_light_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.EdgeLightSettings" />



        <!-- Keyguard user switcher -->

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_show_carrier"
            android:title="@string/status_bar_carrier_lock_screen_title"
            android:summary="@string/status_bar_carrier_lock_screen_summary"
            android:defaultValue="true" />

        <!-- Shortcuts -->

    </PreferenceCategory>



    <PreferenceCategory
        android:key="lockscreen_custom_category"
        android:title="@string/udfps_custom_title">

        <Preference
            android:key="udfps_cust"
            android:title="@string/udfps_cust_title"
            android:summary="@string/udfps_cust_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.UdfpsCust" />

    </PreferenceCategory>



    <PreferenceCategory
        android:key="lock_screen_fingerprint_category"
        android:title="@string/lock_screen_fingerprint_category">

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="enable_ripple_effect"
            android:title="@string/lock_screen_fingerprint_ripple_title"
            android:summary="@string/lock_screen_fingerprint_ripple_summary"
            android:defaultValue="true" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="fp_success_vibrate"
            android:title="@string/lock_screen_fingerprint_success_vibration_title"
            android:summary="@string/lock_screen_fingerprint_success_vibration_summary"
            android:defaultValue="true" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="fp_error_vibrate"
            android:title="@string/lock_screen_fingerprint_error_vibration_title"
            android:summary="@string/lock_screen_fingerprint_error_vibration_summary"
	    android:defaultValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
