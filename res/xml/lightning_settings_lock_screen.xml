<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lock_screen_title">

    <PreferenceCategory
        android:key="lock_screen_clock_category"
        android:title="@string/lock_screen_clock_category">

        <!-- Custom clock style -->
        <Preference
            android:key="clock_styles_settings"
            android:title="@string/ls_clock_title"
            android:summary="@string/ls_clock_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.ClockStyles"
            android:icon="@drawable/ic_tv_sub_ls_clock" />

        <!-- Depth wallpaper -->
        <com.lightning.thunderbolt.preferences.SystemSettingPrimarySwitchPreference
            android:key="depth_wallpaper_enabled"
            android:title="@string/dw_wallpaper_enabled_title"
            android:summary="@string/dw_wallpaper_enabled_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.WallpaperDepth"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_ls_depth" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lock_screen_media_category"
        android:title="@string/lock_screen_media_category">

        <!-- Now Playing -->
        <com.lightning.thunderbolt.preferences.SystemSettingPrimarySwitchPreference
            android:key="nowplaying_enabled"
            android:title="@string/nowplaying_title"
            android:summary="@string/nowplaying_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.NowPlayingSettings"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_ls_nowplaying" />

        <!-- Edge light -->

        <!-- Lockscreen Media Art -->

        <!-- Pulse music visualizer -->

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lock_screen_interface_category"
        android:title="@string/lock_screen_interface_category">

        <!-- Ambient Wallpaper -->
        <com.lightning.thunderbolt.preferences.SecureSettingSwitchPreference
            android:key="doze_always_on_wallpaper_enabled"
            android:title="@string/lightning_doze_always_on_wallpaper_title"
            android:summary="@string/doze_always_on_wallpaper_summary"
            android:defaultValue="@*android:bool/config_dozeSupportsAodWallpaper"
            android:icon="@drawable/ic_tv_sub_ls_ambient" />

        <!-- Charging stats -->

        <!-- Remaining charging time -->
        <!--<com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_charging_time"
            android:title="@string/lock_screen_charging_time_title"
            android:summary="@string/lock_screen_charging_time_summary"
            android:defaultValue="true" />

        <com.lightning.thunderbolt.preferences.SecureSettingSwitchPreference
            android:key="keyguard_scrim_transparent"
            android:title="@string/keyguard_scrim_transparent_title"
            android:summary="@string/keyguard_scrim_transparent_summary"
            android:defaultValue="false" />-->

    </PreferenceCategory>

    <!--<PreferenceCategory
        android:key="ambient_display_category"
        android:title="@string/ambient_display_category_title">

        <com.lightning.thunderbolt.preferences.SystemSettingListPreference
            android:key="ambient_show_settings"
            android:title="@string/ambient_bottom_title"
            android:entries="@array/ambient_bottom_entries"
            android:entryValues="@array/ambient_bottom_values"
            android:summary="%s"
            android:defaultValue="1" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="ambient_show_settings_icons"
            android:title="@string/display_icon_title"
            android:summary="@string/display_icon_summary"
            android:defaultValue="false" />

    </PreferenceCategory>-->

    <PreferenceCategory
        android:key="lockscreen_weather_category"
        android:title="@string/lockscreen_weather_category">

        <!-- Smartspace -->
        <com.lightning.thunderbolt.preferences.SecureSettingSwitchPreference
            android:key="lockscreen_smartspace_enabled"
            android:title="@string/lockscreen_smartspace_title"
            android:summary="@string/lockscreen_smartspace_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_tv_sub_ls_smartspace" />

        <Preference
            android:title="@string/weather_settings_title"
            android:summary="@string/weather_settings_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.omnirom.omnijaws"
                android:targetClass="org.omnirom.omnijaws.SettingsActivity" />
        </Preference>

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_enabled"
            android:title="@string/lockscreen_weather_title"
            android:summary="@string/lockscreen_weather_summary"
            android:icon="@drawable/ic_tv_sub_ls_weather" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_location"
            android:title="@string/lockscreen_weather_location_title"
            android:summary="@string/lockscreen_weather_location_summary"
            android:dependency="lockscreen_weather_enabled" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_text"
            android:title="@string/lockscreen_weather_text_title"
            android:summary="@string/lockscreen_weather_text_summary"
            android:defaultValue="true"
            android:dependency="lockscreen_weather_enabled" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_wind_info"
            android:title="@string/lockscreen_weather_wind_info_title"
            android:summary="@string/lockscreen_weather_wind_info_summary"
            android:defaultValue="false"
            android:dependency="lockscreen_weather_enabled" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_humidity_info"
            android:title="@string/lockscreen_weather_humidity_info_title"
            android:summary="@string/lockscreen_weather_humidity_info_summary"
            android:defaultValue="false"
            android:dependency="lockscreen_weather_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lock_screen_charging_effects_category"
        android:title="@string/lock_screen_charging_effects_category">

        <com.lightning.thunderbolt.preferences.SystemSettingPrimarySwitchPreference
            android:key="charging_animation_enabled"
            android:title="@string/charging_animation_title"
            android:summary="@string/charging_animation_summary"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.ChargingAnimationSettings"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_ls_charging" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lockscreen_gestures_category"
        android:title="@string/lock_screen_fingerprint_category">

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="enable_ripple_effect"
            android:title="@string/lock_screen_fingerprint_ripple_title"
            android:summary="@string/lock_screen_fingerprint_ripple_summary"
            android:defaultValue="true" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="fp_success_vibrate"
            android:title="@string/lock_screen_fingerprint_success_vibration_title"
            android:summary="@string/lock_screen_fingerprint_success_vibration_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_tv_sub_ls_fingerprint" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="fp_error_vibrate"
            android:title="@string/lock_screen_fingerprint_error_vibration_title"
            android:summary="@string/lock_screen_fingerprint_error_vibration_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_tv_sub_ls_fingerprint" />

    </PreferenceCategory>


</PreferenceScreen>
