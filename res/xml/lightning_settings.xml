<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lightning_dashboard_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="tv_active_look"
        android:layout="@layout/tv_active_look"
        android:selectable="false" />

    <androidx.preference.PreferenceCategory
        android:key="tv_cat_style"
        android:title="@string/tv_cat_style"
        android:layout="@layout/tv_category">

        <!-- Monet settings -->
        <Preference
            android:key="monet_settings"
            android:title="@string/themes_monet_title"
            android:summary="@string/themes_monet_summary"
            android:icon="@drawable/ic_tv_hub_monet"
            android:fragment="com.lightning.thunderbolt.fragments.themes.ColorsSettingsFragment" />

        <!-- Themes -->
        <Preference
            android:key="themes"
            android:title="@string/themes_title"
            android:summary="@string/themes_summary"
            android:icon="@drawable/ic_tv_hub_themes"
            android:fragment="com.lightning.thunderbolt.fragments.themes.Themes" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="tv_cat_interface"
        android:title="@string/tv_cat_interface"
        android:layout="@layout/tv_category">

        <!-- Lock screen -->
        <Preference
            android:key="lock_screen"
            android:title="@string/lock_screen_title"
            android:summary="@string/lock_screen_summary"
            android:icon="@drawable/ic_tv_hub_lock"
            android:fragment="com.lightning.thunderbolt.fragments.lockscreen.LockScreen"/>

        <!-- Status bar -->
        <Preference
            android:key="status_bar"
            android:title="@string/status_bar_title"
            android:summary="@string/status_bar_summary"
            android:icon="@drawable/ic_tv_hub_status"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.StatusBar"/>

        <!--
        <Preference
            android:key="notifications"
            android:title="@string/lightning_notifications_title"
            android:summary="@string/notifications_summary"
            android:icon="@drawable/ic_tv_hub_notify"
            android:fragment="com.lightning.thunderbolt.fragments.notifications.Notifications"/>
        -->

        <!-- Quick settings -->
        <Preference
            android:key="quick_settings"
            android:title="@string/quick_settings_title"
            android:summary="@string/quick_settings_summary"
            android:icon="@drawable/ic_tv_hub_quick"
            android:fragment="com.lightning.thunderbolt.fragments.quicksettings.QuickSettings"/>

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="tv_cat_system"
        android:title="@string/tv_cat_system"
        android:layout="@layout/tv_category">

        <!-- Power menu -->
        <Preference
            android:key="power_menu"
            android:title="@string/power_menu_title"
            android:summary="@string/power_menu_summary"
            android:icon="@drawable/ic_tv_hub_power"
            android:fragment="com.lightning.thunderbolt.fragments.powermenu.PowerMenu"/>

        <!-- Miscellaneous -->
        <Preference
            android:key="miscellaneous"
            android:title="@string/miscellaneous_title"
            android:summary="@string/miscellaneous_summary"
            android:icon="@drawable/ic_tv_hub_misc"
            android:fragment="com.lightning.thunderbolt.fragments.miscellaneous.Miscellaneous"/>

        <Preference
            android:key="spoofing"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_summary"
            android:icon="@drawable/ic_tv_hub_spoof"
            android:fragment="com.lightning.thunderbolt.fragments.miscellaneous.Spoofing" />

    </androidx.preference.PreferenceCategory>
</PreferenceScreen>
