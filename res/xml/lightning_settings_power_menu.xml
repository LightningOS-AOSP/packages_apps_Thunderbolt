<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/power_menu_title">


    <com.lightning.thunderbolt.preferences.SecureSettingSwitchPreference
        android:key="advanced_reboot"
        android:title="@string/global_actions_advanced_reboot_title"
        android:summary="@string/global_actions_advanced_reboot_summary"
        android:defaultValue="true" />

    <PreferenceCategory
        android:key="power_menu_interface_category"
        android:title="@string/power_menu_interface_category">

        <!-- Power menu actions -->
        <Preference
            android:key="power_menu_actions"
            android:title="@string/power_menu_actions_title"
            android:summary="@string/power_menu_actions_summary"
            android:fragment="com.lightning.thunderbolt.fragments.powermenu.PowerMenuActions" />
    </PreferenceCategory>


</PreferenceScreen>
