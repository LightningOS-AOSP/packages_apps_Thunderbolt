<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/themes_title">

    <PreferenceCategory
        android:key="themes_fonts_category"
        android:title="@string/themes_fonts_category">


        <!-- Prebuilt Fonts -->
        <Preference
            android:key="android.theme.customization.fonts"
            android:title="@string/themes_system_font_title"
            android:summary="@string/themes_system_font_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.fonts.FontsPicker" />

        <!-- Custom Font Picker -->

        <!-- Custom Font Info -->

        <!-- Reset Custom Font Button -->

        <!-- Reboot Button for Custom Font -->

        <Preference
            android:key="android.theme.customization.lockscreen_clock_font"
            android:title="@string/theme_customization_lock_clock_title"
            android:summary="@string/theme_customization_lock_clock_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.fonts.LockClockFontsPicker"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_icons_category"
        android:title="@string/themes_icons_category">

        <!-- System icons -->
        <Preference
            android:key="android.theme.customization.icon_pack"
            android:title="@string/themes_system_icons_title"
            android:summary="@string/themes_system_icons_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.SystemIcons"/>

        <!-- Icon shape -->
        <Preference
            android:key="android.theme.customization.adaptive_icon_shape"
            android:title="@string/themes_icon_shape_title"
            android:summary="@string/themes_icon_shape_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.IconShapes"/>

        <!-- Signal icon -->
        <Preference
            android:key="android.theme.customization.signal_icon"
            android:title="@string/themes_signal_icon_title"
            android:summary="@string/themes_signal_icon_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.SignalIcons"/>

        <!-- Wifi icon -->
        <Preference
            android:key="android.theme.customization.wifi_icon"
            android:title="@string/themes_wifi_icon_title"
            android:summary="@string/themes_wifi_icon_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.WifiIcons"/>

        <!-- Navigation bar icons -->
        <Preference
            android:key="android.theme.customization.navbar"
            android:title="@string/themes_navigation_bar_icons_title"
            android:summary="@string/themes_navigation_bar_icons_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.NavigationBarIcons"/>
            
    </PreferenceCategory>

    <PreferenceCategory
        android:key="video_wallpaper_category"
        android:title="@string/video_wallpaper_category">

        <Preference
            android:key="video_wallpaper"
            android:title="@string/video_wallpaper_category_title"
            android:summary="@string/video_wallpaper_category_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.VideoWallpaperFragment" />

        <Preference
            android:key="wallpaper_settings"
            android:title="@string/lightning_wallpaper_settings_title"
            android:summary="@string/wallpaper_settings_summary"
            android:fragment="com.lightning.thunderbolt.fragments.themes.Wallpaper" />

    </PreferenceCategory>




    <PreferenceCategory
        android:key="themes_launcher_category"
        android:title="@string/themes_launcher_category">

        <Preference
            android:key="quickswitch"
            android:title="@string/quickswitch_launcher_title"
            android:summary="@string/quickswitch_launcher_summary"
            android:fragment="com.lightning.thunderbolt.fragments.miscellaneous.QuickSwitch" />

    </PreferenceCategory>

</PreferenceScreen>
