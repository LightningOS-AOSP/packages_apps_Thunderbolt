<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/thunderbolt_dashboard_title" >

    <!-- Core (amber): Bolt Bar -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="boltbar"
        android:title="@string/category_boltbar_title"
        android:summary="@string/category_boltbar_subtitle"
        android:fragment="com.lightning.thunderbolt.Boltbar" />

    <!-- Core (amber): Flash Panel -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="flash_panel"
        android:title="@string/category_flashpanel_title"
        android:summary="@string/category_flashpanel_subtitle"
        android:fragment="com.lightning.thunderbolt.FlashPanel" />

    <!-- Movement (violet): Motion & Navigation -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="motionnav_settings"
        android:title="@string/category_motionnav_title"
        android:summary="@string/category_motionnav_subtitle"
        android:fragment="com.lightning.thunderbolt.MotionNav" />

    <!-- Security (cyan): Static Field -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="staticfield_settings"
        android:title="@string/category_staticfield_title"
        android:summary="@string/category_staticfield_subtitle"
        android:fragment="com.lightning.thunderbolt.StaticField" />

    <!-- Appearance (violet): Storm UI & Notifications -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="stormui_settings"
        android:title="@string/category_stormui_title"
        android:summary="@string/category_stormui_subtitle"
        android:fragment="com.lightning.thunderbolt.StormUI" />

    <!-- Extras (amber): Lightning Perks -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="lightningperks_settings"
        android:title="@string/category_lightningperks_title"
        android:summary="@string/category_lightningperks_subtitle"
        android:fragment="com.lightning.thunderbolt.LightningPerks" />

    <!-- Extras (amber -> cyan gradient, special): ROM Collectibles -->
    <com.lightning.thunderbolt.ThunderboltDashboardPreference
        android:key="romcollectibles_settings"
        android:title="@string/category_romcollectibles_title"
        android:summary="@string/category_romcollectibles_subtitle"
        android:fragment="com.lightning.thunderbolt.ROMCollectibles" />

    <!-- Legend -->
    <Preference
        android:key="legend"
        android:selectable="false"
        android:layout="@layout/preference_thunderbolt_legend" />

</PreferenceScreen>
