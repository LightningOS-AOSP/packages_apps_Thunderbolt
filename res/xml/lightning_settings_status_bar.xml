<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/status_bar_title">

    <PreferenceCategory
        android:key="status_bar_gestures_category"
        android:title="@string/gestures_category_title">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="double_tap_sleep_gesture"
            android:title="@string/status_bar_double_tap_to_sleep_title"
            android:summary="@string/status_bar_double_tap_to_sleep_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_tv_sub_sb_gestures" />

        <!-- Status bar brightness control -->


        <!-- Quick pull down -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="qs_quick_pulldown"
            android:title="@string/status_bar_quick_qs_pulldown_title"
            android:entries="@array/status_bar_quick_qs_pulldown_entries"
            android:entryValues="@array/status_bar_quick_qs_pulldown_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_features_category"
        android:title="@string/status_bar_features_category">

        <!-- Dynamic Island -->
        <Preference
            android:key="status_bar_dynamic_island"
            android:title="@string/status_bar_dynamic_island_title"
            android:summary="@string/status_bar_dynamic_island_summary"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.DynamicIslandSettings"
            android:icon="@drawable/ic_tv_sub_sb_island" />

        <!-- Statusbar lyric -->

        <com.lightning.thunderbolt.preferences.SecureSettingPrimarySwitchPreference
            android:key="ax_dynamic_bar_enabled"
            android:title="@string/dynamic_bar"
            android:summary="@string/dynamic_bar_enable_summary"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.DynamicBar"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_sb_dynamic_bar" />

        <!-- Cutout Progress -->
        <com.lightning.thunderbolt.preferences.SecureSettingPrimarySwitchPreference
            android:key="cutout_progress_enabled"
            android:title="@string/cutout_progress_title"
            android:summary="@string/cutout_progress_summary"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.CutoutProgressSettingsFragment"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_sb_cutout" />

        <!-- Network traffic -->
        <com.lightning.thunderbolt.preferences.SystemSettingPrimarySwitchPreference
            android:key="network_traffic_enabled"
            android:title="@string/status_bar_network_traffic_settings_title"
            android:summary="@string/status_bar_network_traffic_settings_summary"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.NetworkTrafficSettings"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_sb_traffic" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_icons_category"
        android:title="@string/status_bar_icons_category">

        <!-- Status bar tuner -->
        <Preference
            android:key="status_bar_icons"
            android:title="@string/status_bar_tuner_title"
            android:summary="@string/status_bar_tuner_summary">
                <intent android:action="com.android.settings.action.STATUS_BAR_TUNER"
            android:icon="@drawable/ic_tv_sub_sb_tuner" />
        </Preference>

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_clock"
            android:title="@string/status_bar_clock_position_title"
            android:summary="%s"
            android:dialogTitle="@string/status_bar_clock_position_title"
            android:entries="@array/status_bar_clock_position_entries"
            android:entryValues="@array/status_bar_clock_position_values"
            android:defaultValue="2" />

        <!-- Clock & date -->
        <Preference
            android:key="clock"
            android:title="@string/status_bar_clock_and_date_title"
            android:summary="@string/status_bar_clock_and_date_summary"
            android:fragment="com.lightning.thunderbolt.fragments.statusbar.Clock"
            android:icon="@drawable/ic_tv_sub_sb_clock" />

        <!-- Statusbar Clock background chip -->
        <com.lightning.thunderbolt.preferences.ClockBackgroundChipPreference
            android:key="statusbar_clock_chip"
            android:title="@string/statusbar_clock_chip_title" />

        <com.lightning.thunderbolt.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_clock_chip_gradient_start_color"
            android:title="@string/clock_chip_gradient_start_color_title"
            android:summary="@string/clock_chip_gradient_start_color_summary"
            android:visible="false" />

        <com.lightning.thunderbolt.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_clock_chip_gradient_end_color"
            android:title="@string/clock_chip_gradient_end_color_title"
            android:summary="@string/clock_chip_gradient_end_color_summary"
            android:visible="false" />

        <com.lightning.thunderbolt.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_clock_chip_gradient_angle"
            android:title="@string/clock_chip_gradient_angle_title"
            android:summary="@string/clock_chip_gradient_angle_summary"
            android:defaultValue="0"
            android:max="360"
            settings:min="0"
            settings:interval="1"
            settings:units="°"
            android:visible="false" />

        <com.lightning.thunderbolt.preferences.SystemSettingListPreference
            android:key="statusbar_clock_chip_gradient_mask_text"
            android:title="@string/clock_chip_gradient_mask_text_title"
            android:summary="%s"
            android:entries="@array/clock_chip_gradient_mask_text_entries"
            android:entryValues="@array/clock_chip_gradient_mask_text_values"
            android:defaultValue="0"
            android:visible="false" />

        <!-- Bluetooth battery status -->
        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="bluetooth_show_battery"
            android:title="@string/status_bar_bluetooth_battery_title"
            android:summary="@string/status_bar_bluetooth_battery_summary"
            android:defaultValue="true" />

        <!-- Colored icons -->
        <!--<com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="statusbar_colored_icons"
            android:title="@string/status_bar_colored_icons_title"
            android:summary="@string/status_bar_colored_icons_summary"
            android:defaultValue="false" />

        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="statusbar_notif_count"
            android:title="@string/status_bar_notif_count_title"
            android:summary="@string/status_bar_notif_count_summary"
            android:defaultValue="false" />-->
    </PreferenceCategory>

    <!-- Status bar battery customizations -->
    <PreferenceCategory
        android:title="@string/status_bar_battery_category_title">

        <!-- Battery styles -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:title="@string/status_bar_battery_style_title"
            android:entries="@array/status_bar_battery_style_entries"
            android:entryValues="@array/status_bar_battery_style_values"
            android:defaultValue="0"
            android:icon="@drawable/ic_tv_sub_sb_battery" />

        <!-- Battery percent -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:title="@string/status_bar_battery_percent_title"
            android:entries="@array/status_bar_battery_percent_entries"
            android:entryValues="@array/status_bar_battery_percent_values"
            android:defaultValue="0" />

        <!-- Battery percentage when charging -->
        <!--<com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="status_bar_battery_text_charging"
            android:title="@string/status_bar_battery_text_charging_title"
            android:summary="@string/status_bar_battery_text_charging_summary"
            android:defaultValue="true" />-->

        <!-- Battery bar -->

    </PreferenceCategory>

    <!-- Carrier label -->
    <PreferenceCategory
        android:key="status_bar_carrier_key"
        android:title="@string/status_bar_carrier_category_title">

        <com.lightning.thunderbolt.preferences.SystemSettingListPreference
            android:key="lockscreen_show_carrier"
            android:title="@string/lockscreen_show_carrier_title"
            android:dialogTitle="@string/lockscreen_show_carrier_title"
            android:summary="%s"
            android:entries="@array/status_bar_carrier_display_entries"
            android:entryValues="@array/status_bar_carrier_display_values"
            android:defaultValue="1"
        android:icon="@drawable/ic_tv_sub_sb_carrier" />

        <Preference
            android:key="lockscreen_show_custom_carrier_text"
            android:title="@string/custom_carrier_label_title"
            android:summary="@string/custom_carrier_label_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_logo_category"
        android:title="@string/status_bar_logo_title">

        <!-- Logo -->
        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="status_bar_logo"
            android:title="@string/status_bar_logo_title"
            android:summary="@string/status_bar_logo_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_tv_sub_sb_logo" />

        <!-- Logo position -->
        <com.lightning.thunderbolt.preferences.SystemSettingListPreference
            android:key="status_bar_logo_position"
            android:title="@string/status_bar_logo_position_title"
            android:entries="@array/status_bar_logo_position_entries"
            android:entryValues="@array/status_bar_logo_position_values"
            android:defaultValue="0" />

        <!-- Logo style -->
        <com.lightning.thunderbolt.preferences.StatusBarLogoStylePreference
            android:key="status_bar_logo_style"
            android:title="@string/status_bar_logo_style_title"
            android:summary="@string/status_bar_logo_style_summary" />

        <Preference
            android:key="status_bar_logo_custom_image"
            android:title="@string/status_bar_logo_custom_image_title"
            android:summary="@string/status_bar_logo_custom_image_pick_summary" />

        <!-- Logo color type -->
        <com.lightning.thunderbolt.preferences.SystemSettingListPreference
            android:key="status_bar_logo_color"
            android:title="@string/status_bar_logo_color_title"
            android:entries="@array/status_bar_logo_color_entries"
            android:entryValues="@array/status_bar_logo_color_values"
            android:defaultValue="0" />

        <!-- Logo custom color -->
        <com.lightning.thunderbolt.preferences.colorpicker.ColorPickerPreference
            android:key="status_bar_logo_color_picker"
            android:title="@string/status_bar_logo_color_custom"
            settings:defaultValue="0xFFFFFFFF" />
    </PreferenceCategory>

</PreferenceScreen>
