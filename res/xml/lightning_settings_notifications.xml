<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lightning_notifications_title" >

    <PreferenceCategory
        android:key="media_category"
        android:title="@string/media_category_title">


        <!-- Waveform seekbar -->
        <com.lightning.thunderbolt.preferences.SystemSettingSwitchPreference
            android:key="media_waveform_seekbar"
            android:title="@string/media_waveform_seekbar_title"
            android:summary="@string/media_waveform_seekbar_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="notification_category"
        android:title="@string/notification_category_title">

        <Preference
            android:key="essential_notifications"
            android:title="@string/essential_notifications"
            android:summary="@string/essential_notifications_summary"
            android:fragment="com.lightning.thunderbolt.fragments.notification.EssentialNotificationsSettings" />


        <!-- Notification guts kill app button -->

        <!-- Show clipboard overlay -->



        <!-- Notification app icon -->

        <!-- Notification themed app icon -->
    </PreferenceCategory>



    <PreferenceCategory
        android:key="light_brightness"
        android:title="@string/light_brightness_category">

        <!-- Battery light -->
        <Preference
            android:key="battery_lights"
            android:title="@string/battery_light_title"
            android:summary="@string/battery_light_summary"
            android:fragment="com.lightning.thunderbolt.fragments.notifications.notificationlight.BatteryLightSettings" />

        <!-- Notification lights -->
        <Preference
            android:key="notification_lights"
            android:title="@string/notification_light_title"
            android:summary="@string/notification_light_summary"
            android:fragment="com.lightning.thunderbolt.fragments.notifications.notificationlight.NotificationLightSettings" />
    </PreferenceCategory>

</PreferenceScreen>
