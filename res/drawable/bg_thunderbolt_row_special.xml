<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/thunderbolt_panel" />
            <corners android:radius="@dimen/tb_row_corner_radius" />
            <stroke android:width="1dp" android:color="@color/thunderbolt_line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#14f5c244"
                android:centerColor="#00000000"
                android:endColor="#00000000"
                android:angle="0" />
            <corners android:radius="@dimen/tb_row_corner_radius" />
        </shape>
    </item>
</layer-list>
