<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Thunderbolt.Display" parent="android:TextAppearance.Material.Headline">
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tv_on_surface</item>
    </style>

    <style name="TextAppearance.Thunderbolt.Display.Sub" parent="TextAppearance.Thunderbolt.Display">
        <item name="android:textSize">36sp</item>
    </style>

    <style name="TextAppearance.Thunderbolt.TitleLarge" parent="android:TextAppearance.Material.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tv_on_primary_container</item>
    </style>

    <style name="TextAppearance.Thunderbolt.Headline" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tv_on_surface</item>
    </style>

    <style name="TextAppearance.Thunderbolt.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tv_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Thunderbolt.LabelLarge" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0071</item>
        <item name="android:textColor">@color/tv_primary</item>
    </style>

    <style name="TextAppearance.Thunderbolt.LabelMedium" parent="android:TextAppearance.Material.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/tv_on_primary_container</item>
    </style>

    <style name="TextAppearance.Thunderbolt.CellLabel" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tv_on_surface</item>
    </style>

    <style name="ThemeOverlay.Thunderbolt.SubPage" parent="">
        <item name="android:colorAccent">@color/tv_primary</item>
        <item name="colorAccent">@color/tv_primary</item>
        <item name="android:colorControlActivated">@color/tv_primary</item>
        <item name="android:colorControlHighlight">@color/tv_primary_container</item>
        <item name="android:seekBarStyle">@style/Widget.Thunderbolt.SeekBar</item>
        <item name="android:switchStyle">@style/Widget.Thunderbolt.SwitchCompat</item>
        <item name="switchStyle">@style/Widget.Thunderbolt.SwitchCompat</item>
        <item name="android:textColorPrimary">@color/tv_on_surface</item>
        <item name="android:textColorSecondary">@color/tv_on_surface_variant</item>
        <item name="android:windowBackground">@color/tv_surface</item>
    </style>

    <style name="Widget.Thunderbolt.SwitchCompat" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:track">@drawable/tv_switch_track</item>
        <item name="android:thumb">@drawable/tv_switch_thumb</item>
        <item name="android:switchMinWidth">52dp</item>
    </style>

    <style name="Widget.Thunderbolt.SeekBar" parent="android:Widget.Material.SeekBar">
        <item name="android:progressDrawable">@drawable/tv_slider_track</item>
        <item name="android:thumb">@drawable/tv_slider_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:minHeight">16dp</item>
        <item name="android:maxHeight">16dp</item>
    </style>

</resources>
