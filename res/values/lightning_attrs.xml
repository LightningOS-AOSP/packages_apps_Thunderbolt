<resources>

    <!-- ColorPicker -->
    <declare-styleable name="ColorPickerPreference">
        <attr name="alphaSlider" format="boolean" />
        <attr name="showPreview" format="boolean" />
        <attr name="showReset" format="boolean" />
        <attr name="dividerAbove" format="boolean" />
        <attr name="dividerBelow" format="boolean" />
    </declare-styleable>

    <!-- Base attributes available to CustomSeekBarPreference. -->
    <declare-styleable name="CustomSeekBarPreference">
        <attr name="defaultValueText" format="string" />
        <attr name="interval" format="integer" />
        <attr name="showSign" format="boolean" />
        <attr name="units" format="string|reference" />
        <attr name="continuousUpdates" format="boolean" />
    </declare-styleable>

    <!-- Base attributes available to OverlaySwitchPreference. -->
    <declare-styleable name="OverlaySwitchPreference">
        <attr name="dkey" format="string" />
        <attr name="dkeyNightOnly" format="boolean" />
    </declare-styleable>

    <!-- Base attributes available to DeviceConfigSwitchPreference. -->
    <declare-styleable name="DeviceConfigSwitchPreference">
        <attr name="deviceConfigNamespace" format="string" />
        <attr name="deviceConfigFlag" format="string" />
        <attr name="deviceConfigDefault" format="boolean" />
    </declare-styleable>

    <!-- ThunderboltDashboardPreference -->
    <declare-styleable name="ThunderboltDashboardPreference">
        <attr name="tbAccent" format="integer" />
        <attr name="tbIcon" format="reference" />
        <attr name="tbSpecial" format="boolean" />
    </declare-styleable>

    <!-- Accent color applied to Thunderbolt sub-setting screens. -->
    <attr name="thunderboltAccent" format="color" />
    <!-- Muted chip background variant of the Thunderbolt accent. -->
    <attr name="thunderboltAccentDim" format="color" />

    <!-- About phone page category theme colors. -->
    <attr name="colorCategoryHardwareFill" format="color" />
    <attr name="colorCategoryHardwareBar" format="color" />
    <attr name="colorCategoryHardwareIcon" format="color" />
    <attr name="colorCategoryHardwareLabel" format="color" />
    <attr name="colorCategoryHardwareValue" format="color" />

    <attr name="colorCategorySoftwareFill" format="color" />
    <attr name="colorCategorySoftwareBar" format="color" />
    <attr name="colorCategorySoftwareIcon" format="color" />
    <attr name="colorCategorySoftwareLabel" format="color" />
    <attr name="colorCategorySoftwareValue" format="color" />

    <attr name="colorCategorySecurityFill" format="color" />
    <attr name="colorCategorySecurityBar" format="color" />
    <attr name="colorCategorySecurityIcon" format="color" />
    <attr name="colorCategorySecurityLabel" format="color" />
    <attr name="colorCategorySecurityValue" format="color" />

    <!-- Scrim drawn over the live wallpaper on the About phone page. -->
    <attr name="colorScrimWallpaper" format="color" />

    <!-- Surface tokens used by the About phone page, equivalent to the
         framework Material tokens but app-defined so they resolve under any
         host theme. -->
    <attr name="aboutSurfaceContainer" format="color" />
    <attr name="aboutSurface" format="color" />
    <attr name="aboutOnSurface" format="color" />
    <attr name="aboutOnSurfaceVariant" format="color" />
    <attr name="aboutOutline" format="color" />
</resources>
