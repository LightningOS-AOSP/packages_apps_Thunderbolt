<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <style name="TextAppearance.TileTitle" parent="@*android:style/TextAppearance.DeviceDefault.Subhead"/>

    <!-- Thunderbolt sub-setting accent overlays.
         Applied via ContextThemeWrapper to the RecyclerView so rows and
         switch/seekbar widgets are tinted per-screen. -->
    <style name="ThemeOverlay.ThunderboltSub" parent="">
        <item name="android:colorAccent">@color/thunderbolt_amber</item>
        <item name="android:colorControlActivated">@color/thunderbolt_amber</item>
        <item name="android:colorControlHighlight">@color/thunderbolt_ripple</item>
        <item name="colorAccent">@color/thunderbolt_amber</item>
        <item name="thunderboltAccent">@color/thunderbolt_amber</item>
        <item name="thunderboltAccentDim">@color/thunderbolt_amber_dim</item>
        <item name="expressiveTwoTargetPreferenceTheme">@style/ThunderboltExpressiveTwoTargetPreferenceTheme</item>
    </style>

    <!--
        TwoTargetPreference (e.g. RestrictedPreference rows such as the Modes list) resolves
        ?expressiveTwoTargetPreferenceWidgetFrameStyle through android:theme="?...". When the
        RecyclerView inflater context is wrapped (Lightning theme), that resolve must be pinned to
        a fixed theme or the widget_frame <LinearLayout> ends up with no layout_width and crashes.
        Just mirror the SettingsLib expressive two-target theme here.
    -->
    <style name="ThunderboltExpressiveTwoTargetPreferenceTheme">
        <item name="expressiveTwoTargetPreferenceRootStyle">@style/ExpressiveTwoTargetPreferenceRootStyle</item>
        <item name="expressiveTwoTargetPreferenceWidgetFrameStyle">@style/ExpressiveTwoTargetPreferenceWidgetFrameStyle</item>
        <item name="expressivePreferenceIconFrameStyle">@style/ExpressivePreferenceIconFrameStyle</item>
        <item name="expressivePreferenceIconStyle">@style/ExpressivePreferenceIconStyle</item>
        <item name="expressivePreferenceTextFrameStyle">@style/ExpressivePreferenceTextFrameStyle</item>
        <item name="expressivePreferenceTextFrameTitleStyle">@style/ExpressivePreferenceTextFrameTitleStyle</item>
        <item name="expressivePreferenceTextFrameSummaryStyle">@style/ExpressivePreferenceTextFrameSummaryStyle</item>
        <item name="expressiveTwoTargetDividerStyle">@style/ExpressiveTwoTargetDividerStyle</item>
        <item name="expressiveTwoTargetDividerImageViewStyle">@style/ExpressiveTwoTargetDividerImageViewStyle</item>
        <item name="expressiveTwoTargetDividerViewStyle">@style/ExpressiveTwoTargetDividerViewStyle</item>
    </style>

    <style name="ThemeOverlay.ThunderboltSub.Violet" parent="">
        <item name="android:colorAccent">@color/thunderbolt_violet</item>
        <item name="android:colorControlActivated">@color/thunderbolt_violet</item>
        <item name="colorAccent">@color/thunderbolt_violet</item>
        <item name="thunderboltAccent">@color/thunderbolt_violet</item>
        <item name="thunderboltAccentDim">@color/thunderbolt_violet_dim</item>
    </style>

    <style name="ThemeOverlay.ThunderboltSub.Cyan" parent="">
        <item name="android:colorAccent">@color/thunderbolt_cyan</item>
        <item name="android:colorControlActivated">@color/thunderbolt_cyan</item>
        <item name="colorAccent">@color/thunderbolt_cyan</item>
        <item name="thunderboltAccent">@color/thunderbolt_cyan</item>
        <item name="thunderboltAccentDim">@color/thunderbolt_cyan_dim</item>
    </style>

</resources>
